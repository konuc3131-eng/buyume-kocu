# Zorunlu: Claude API anahtarın (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Kişi başı günlük ücretsiz analiz sayısı
FREE_DAILY_LIMIT=5

# Önerilir: Upstash Redis (ücretsiz plan yeterli). Yoksa limit sadece bellekte tutulur.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# İsteğe bağlı: model değiştirmek istersen
# MODEL_VISION=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
